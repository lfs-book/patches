-
-                  case BUTTON_TOGGLE_MAXIMIZE:
-                    return {DECORATION_ACTION_TOGGLE_MAXIMIZE, 0};
-
-                  case BUTTON_MINIMIZE:
-                    return {DECORATION_ACTION_MINIMIZE, 0};
