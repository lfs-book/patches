-    }
-
-    noiseColor += noiseRidgeColor;
-
-    // Sky tint
-    float skytint = 0.5;
-    vec3 skyColour1 = vec3(0.1, 0.2, 0.3);
-    vec3 skyColour2 = vec3(0.4, 0.7, 1.0);
