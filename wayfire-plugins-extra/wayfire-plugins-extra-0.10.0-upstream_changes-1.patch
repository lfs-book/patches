+		</option>
+		<option name="radius" type="double">
+			<_short>Radius</_short>
+			<_long>Sets the border radius in pixels.</_long>
+			<default>450.0</default>
+			<min>1.0</min>
+		</option>
+		<option name="zoom" type="double">
