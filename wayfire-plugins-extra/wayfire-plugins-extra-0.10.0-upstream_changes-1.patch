-    for (int i = 0; i < 7; i++) {
-        noiseColor += weight * noise(uv);
-        uv = m * uv + time;
-        weight *= 0.6;
-    }
-
-    // Noise ridge color
-    float noiseRidgeColor = 0.0;
-    uv = vec2(pos) / vec2(gl_NumWorkGroups.x * gl_WorkGroupSize.x, gl_NumWorkGroups.y * gl_WorkGroupSize.y);
-    uv *= 3.0 * cloudscale;  // Adjust scale
-    weight = 0.4;
-    for (int i = 0; i < 7; i++) {
