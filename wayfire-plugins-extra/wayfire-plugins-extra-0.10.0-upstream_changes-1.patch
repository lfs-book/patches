-    vec2 ip = floor(uv); // column, row
-    vec2 odd = vec2(0.5 * mod(ip.y, 2.0), 0.0); // odd line offset
-    vec2 cp = floor(uv - odd) + odd; // dot center
-    float d = length(uv - cp - 0.5) * size; // distance
-    float r = swirl(cp * size, t) * size * 0.5 * amp; // dot radius
