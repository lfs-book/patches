-// I keep a collection of occlusion routines... OK, that sounded really nerdy. :)
-// Anyway, I like this one. I'm assuming it's based on IQ's original.
-float calculateAO(in vec3 p, in vec3 n)
-{
-    float sca = 2., occ = 0.;
-    for(float i=0.; i<5.; i++){
-    
-        float hr = .01 + i*.5/4.;        
-        float dd = map(n * hr + p);
-        occ += (hr - dd)*sca;
-        sca *= 0.7;
-    }
-    return clamp(1.0 - occ, 0., 1.);    
-}
